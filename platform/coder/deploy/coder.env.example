# /etc/sperange/coder.env (mode 0600, owner ubuntu)
CODER_HTTP_ADDRESS=0.0.0.0:7080
CODER_ACCESS_URL=https://sperange.example.org
CODER_WILDCARD_ACCESS_URL=*.sperange.example.org
CODER_TELEMETRY_ENABLE=false
CODER_PROVISIONER_DAEMONS=5
# Built-in PostgreSQL lives in ~ubuntu/.config/coderv2/postgres. Fine for ~10
# users; set CODER_PG_CONNECTION_URL to use an external database instead.

# Login with GitHub (optional; otherwise create users with `coder users create`).
# OAuth app callback: https://sperange.example.org/api/v2/users/oauth2/github/callback
#CODER_OAUTH2_GITHUB_CLIENT_ID=
#CODER_OAUTH2_GITHUB_CLIENT_SECRET=
#CODER_OAUTH2_GITHUB_ALLOW_SIGNUPS=true
#CODER_OAUTH2_GITHUB_ALLOWED_ORGS=your-org
#CODER_OAUTH2_GITHUB_ALLOWED_TEAMS=your-org/biohackathon

# Used by the workspace builds (Terraform -> Ansible), inherited from here.
OS_CLIENT_CONFIG_FILE=/home/ubuntu/clouds.yaml
DENBI_LLM_API_KEY=sk-...
PATH=/home/ubuntu/.venv-openstack/bin:/usr/local/bin:/usr/bin:/bin
