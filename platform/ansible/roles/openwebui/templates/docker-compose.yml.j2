# Managed by spe-ansible (role: openwebui). Do not edit on the instance.
# OpenWebUI pentest frontend for this SPE instance. Bound to localhost only;
# reach it with an SSH tunnel (see output/<instance>/summary.md).
name: spe-frontend
services:
  open-webui:
    image: {{ spe_frontend_webui_image }}
    restart: unless-stopped
    ports:
      - "127.0.0.1:{{ spe_webui_local_port }}:8080"
    env_file: webui.env
    environment:
      ENABLE_OLLAMA_API: "false"
      # Preselected model for new chats (the one carrying the system prompt,
      # see tasks/main.yml) and first in the model picker.
      DEFAULT_MODELS: "{{ spe_webui_model_id }}"
      MODEL_ORDER_LIST: '["{{ spe_webui_model_id }}"]'
      WEBUI_AUTH: "{{ 'true' if spe_webui_auth else 'false' }}"
      ENABLE_SIGNUP: "{{ 'true' if spe_webui_auth else 'false' }}"
      DEFAULT_USER_ROLE: pending
      ENABLE_CODE_INTERPRETER: "false"
      # Tags are set by hand as outcome labels (see reports/run_report.md.j2);
      # LLM-generated tags would mix with them.
      ENABLE_TAGS_GENERATION: "false"
      ENABLE_CODE_EXECUTION: "false"
      AIOHTTP_CLIENT_STREAM_IDLE_TIMEOUT: "120"
      # Wires the open-terminal tool server in on first boot (fresh data volume).
      TERMINAL_SERVER_CONNECTIONS: '[{"id":"spe-open-terminal","name":"Open Terminal","url":"http://open-terminal:8000","key":"{{ spe_terminal_api_key }}","auth_type":"bearer","enabled":true}]'
    security_opt:
      - no-new-privileges:true
    depends_on:
      - open-terminal
    volumes:
      - open-webui-data:/app/backend/data
  open-terminal:
    image: {{ spe_frontend_terminal_image }}
    restart: unless-stopped
    env_file: terminal.env
    environment:
      OPEN_TERMINAL_FILE_BROWSER_ROOT: /home/user
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - SETGID
    cpus: 2.0
    mem_limit: 2g
    pids_limit: 256
    volumes:
      - open-terminal-data:/home/user
volumes:
  open-webui-data:
  open-terminal-data:
