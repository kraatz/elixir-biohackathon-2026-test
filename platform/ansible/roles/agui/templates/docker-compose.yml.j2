# Managed by spe-ansible (role: agui). Do not edit on the instance.
# AG-UI agent frontend for this SPE instance; ports bound to localhost only, reach
# them with an SSH tunnel (see output/<instance>/summary.md). Same project name as
# the openwebui frontend, so switching spe_frontend replaces one stack with the other.
name: spe-frontend
services:
  chat-ui:
    image: {{ agui_ui_image }}
    restart: unless-stopped
    ports:
      - "127.0.0.1:{{ spe_agui_ui_port }}:3000"
    env_file: chat-ui.env
    networks: [ui]
    read_only: true
    tmpfs:
      - /tmp
      - /app/.next/cache:uid=1000,gid=1000,mode=0700
    cap_drop: [ALL]
    security_opt:
      - no-new-privileges:true
    mem_limit: 512m
    pids_limit: 256
  agent:
    image: {{ agui_agent_image }}
    restart: unless-stopped
    ports:
      - "127.0.0.1:{{ spe_agui_agent_port }}:8100"
    env_file: agent.env
    labels:
      # agent.yaml and the prompt are bind mounts: a change to them alone would not
      # recreate the container, so their hash is part of its configuration.
      spe.agent-config: "{{ agui_config_hash }}"
    volumes:
      - ./agent.yaml:/etc/spe-agent/agent.yaml:ro
      - ./system_prompt.txt:/etc/spe-agent/system_prompt.txt:ro
      - agent-runs:/var/lib/spe-agent
    networks: [ui, tools]
    read_only: true
    tmpfs:
      - /tmp
    cap_drop: [ALL]
    security_opt:
      - no-new-privileges:true
    mem_limit: 1g
    pids_limit: 256
  sandbox:
    image: {{ spe_frontend_terminal_image }}
    restart: unless-stopped
    env_file: terminal.env
    environment:
      OPEN_TERMINAL_FILE_BROWSER_ROOT: /home/user
    networks: [tools]
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - SETGID
    cpus: 2.0
    mem_limit: 2g
    pids_limit: 256
    volumes:
      - open-terminal-data:/home/user
networks:
  ui: {}
  tools: {}
volumes:
  agent-runs: {}
  open-terminal-data: {}
